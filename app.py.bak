import json
import logging
import math
import os
import sqlite3
from contextlib import contextmanager
from pathlib import Path

from dotenv import dotenv_values, load_dotenv
from flask import Flask, jsonify, redirect, render_template, request
from google import genai
from google.genai import types
from google.genai.errors import APIError

BASE_DIR = Path(__file__).resolve().parent
DB_PATH = BASE_DIR / 'mythoverse.db'
logger = logging.getLogger(__name__)


def load_environment(env_path=None):
    dotenv_path = env_path or BASE_DIR / '.env'
    values = dotenv_values(dotenv_path)
    load_dotenv(dotenv_path=dotenv_path, override=False)
    for name in ('GEMINI_API_KEY', 'GEMINI_MODEL'):
        if values.get(name):
            os.environ[name] = values[name]


load_environment()

app = Flask(__name__, static_folder='static', template_folder='templates')
app.config['SECRET_KEY'] = os.environ.get('SECRET_KEY', 'mythoverse-dev-secret')
app.config['DATABASE'] = os.environ.get('DATABASE_PATH', str(DB_PATH))

GEMINI_API_KEY = os.environ.get('GEMINI_API_KEY')
GEMINI_MODEL = os.environ.get('GEMINI_MODEL', 'gemini-3.5-flash-lite')

AGE_GROUPS = {
    '6-8': 'simple and story-led',
    '9-12': 'clear and practical',
    '13-15': 'thoughtful and reflective',
    '16-18': 'philosophical and analytical',
    '18+': 'deep and nuanced',
}

JUDGE_CRITERIA = ('relevance', 'reasoning', 'evidence', 'clarity', 'rebuttal', 'respect')
JUDGE_RESPONSE_SCHEMA = types.Schema(
    type='OBJECT',
    properties={
        'scorecards': types.Schema(
            type='ARRAY',
            items=types.Schema(
                type='OBJECT',
                properties={
                    'participant_key': types.Schema(type='STRING', enum=['A', 'B']),
                    **{criterion: types.Schema(type='NUMBER') for criterion in JUDGE_CRITERIA},
                    'explanation': types.Schema(type='STRING'),
                    'strengths': types.Schema(type='ARRAY', items=types.Schema(type='STRING')),
                    'improvements': types.Schema(type='ARRAY', items=types.Schema(type='STRING')),
                },
                required=['participant_key', *JUDGE_CRITERIA, 'explanation', 'strengths', 'improvements'],
            ),
        ),
        'summary': types.Schema(type='STRING'),
    },
    required=['scorecards', 'summary'],
)

SQL_SCHEMA = """
CREATE TABLE IF NOT EXISTS content_catalog (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    category TEXT NOT NULL,
    description TEXT,
    url TEXT,
    language TEXT DEFAULT 'en',
    UNIQUE(title, category)
);

CREATE TABLE IF NOT EXISTS ai_conversations (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    student_id TEXT NOT NULL,
    title TEXT,
    created_at TEXT DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS ai_messages (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    conversation_id INTEGER NOT NULL,
    sender TEXT NOT NULL,
    text TEXT NOT NULL,
    created_at TEXT DEFAULT CURRENT_TIMESTAMP,
    metadata TEXT DEFAULT '{}',
    FOREIGN KEY(conversation_id) REFERENCES ai_conversations(id)
);

CREATE TABLE IF NOT EXISTS learning_records (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    student_id TEXT NOT NULL,
    topic TEXT NOT NULL,
    focus_area TEXT,
    score REAL,
    status TEXT,
    activity_type TEXT,
    chapter_name TEXT,
    created_at TEXT DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS debates (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    topic TEXT NOT NULL,
    mode TEXT NOT NULL,
    created_by TEXT NOT NULL,
    age_group TEXT,
    status TEXT DEFAULT 'open',
    created_at TEXT DEFAULT CURRENT_TIMESTAMP,
    winner TEXT,
    current_round INTEGER NOT NULL DEFAULT 1,
    final_feedback TEXT,
    completed_at TEXT
);

CREATE TABLE IF NOT EXISTS debate_participants (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    debate_id INTEGER NOT NULL,
    student_id TEXT NOT NULL,
    role TEXT NOT NULL,
    position TEXT,
    ready INTEGER NOT NULL DEFAULT 0,
    joined_at TEXT DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS debate_arguments (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    debate_id INTEGER NOT NULL,
    speaker TEXT NOT NULL,
    argument TEXT NOT NULL,
    round_number INTEGER DEFAULT 1,
    created_at TEXT DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS debate_scores (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    debate_id INTEGER NOT NULL,
    student_id TEXT NOT NULL,
    relevance REAL,
    reasoning REAL,
    clarity REAL,
    evidence REAL,
    respect REAL,
    total REAL,
    created_at TEXT DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS debate_rounds (
    debate_id INTEGER NOT NULL REFERENCES debates(id) ON DELETE CASCADE,
    round_number INTEGER NOT NULL CHECK (round_number BETWEEN 1 AND 3),
    status TEXT NOT NULL DEFAULT 'not_started'
        CHECK (status IN ('waiting_ready', 'active', 'awaiting_opponent', 'awaiting_judge', 'judging', 'generating_ai', 'completed', 'not_started')),
    started_at TEXT,
    completed_at TEXT,
    judge_summary TEXT,
    PRIMARY KEY (debate_id, round_number)
);

CREATE TABLE IF NOT EXISTS debate_round_submissions (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    debate_id INTEGER NOT NULL REFERENCES debates(id) ON DELETE CASCADE,
    round_number INTEGER NOT NULL CHECK (round_number BETWEEN 1 AND 3),
    participant_id INTEGER NOT NULL REFERENCES debate_participants(id),
    argument TEXT NOT NULL,
    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    UNIQUE (debate_id, round_number, participant_id),
    FOREIGN KEY (debate_id, round_number) REFERENCES debate_rounds(debate_id, round_number)
);

CREATE TABLE IF NOT EXISTS debate_round_scores (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    debate_id INTEGER NOT NULL REFERENCES debates(id) ON DELETE CASCADE,
    round_number INTEGER NOT NULL CHECK (round_number BETWEEN 1 AND 3),
    participant_id INTEGER NOT NULL REFERENCES debate_participants(id),
    relevance REAL NOT NULL CHECK (relevance BETWEEN 0 AND 10),
    reasoning REAL NOT NULL CHECK (reasoning BETWEEN 0 AND 10),
    evidence REAL NOT NULL CHECK (evidence BETWEEN 0 AND 10),
    clarity REAL NOT NULL CHECK (clarity BETWEEN 0 AND 10),
    rebuttal REAL NOT NULL CHECK (rebuttal BETWEEN 0 AND 10),
    respect REAL NOT NULL CHECK (respect BETWEEN 0 AND 10),
    total REAL NOT NULL CHECK (total BETWEEN 0 AND 10),
    explanation TEXT NOT NULL,
    strengths TEXT NOT NULL DEFAULT '[]',
    improvements TEXT NOT NULL DEFAULT '[]',
    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    UNIQUE (debate_id, round_number, participant_id),
    FOREIGN KEY (debate_id, round_number) REFERENCES debate_rounds(debate_id, round_number)
);

CREATE TABLE IF NOT EXISTS dharma_reward_outbox (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    debate_id INTEGER NOT NULL UNIQUE REFERENCES debates(id),
    student_id TEXT NOT NULL,
    points INTEGER NOT NULL DEFAULT 5 CHECK (points = 5),
    status TEXT NOT NULL DEFAULT 'pending_integration'
        CHECK (status IN ('pending_integration', 'credited')),
    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    credited_at TEXT
);

CREATE INDEX IF NOT EXISTS idx_round_submissions_debate_round
    ON debate_round_submissions(debate_id, round_number);

CREATE INDEX IF NOT EXISTS idx_round_scores_debate_round
    ON debate_round_scores(debate_id, round_number);

CREATE TRIGGER IF NOT EXISTS validate_debate_participant_parent
BEFORE INSERT ON debate_participants
WHEN NOT EXISTS (SELECT 1 FROM debates WHERE id = NEW.debate_id)
BEGIN
    SELECT RAISE(ABORT, 'debate does not exist');
END;

CREATE TRIGGER IF NOT EXISTS validate_debate_argument_parent
BEFORE INSERT ON debate_arguments
WHEN NOT EXISTS (SELECT 1 FROM debates WHERE id = NEW.debate_id)
BEGIN
    SELECT RAISE(ABORT, 'debate does not exist');
END;

CREATE TRIGGER IF NOT EXISTS validate_debate_score_participant
BEFORE INSERT ON debate_scores
WHEN NOT EXISTS (
    SELECT 1 FROM debate_participants
    WHERE debate_id = NEW.debate_id AND student_id = NEW.student_id
)
BEGIN
    SELECT RAISE(ABORT, 'debate participant does not exist');
END;

CREATE UNIQUE INDEX IF NOT EXISTS idx_debate_participant_identity
ON debate_participants(debate_id, student_id);
"""


@contextmanager
def get_db_connection():
    connection = sqlite3.connect(app.config.get('DATABASE', DB_PATH))
    connection.row_factory = sqlite3.Row
    connection.execute('PRAGMA foreign_keys = ON')
    try:
        yield connection
        connection.commit()
    except Exception:
        connection.rollback()
        raise
    finally:
        connection.close()


def init_db():
    with get_db_connection() as connection:
        connection.executescript(SQL_SCHEMA)
        migrate_debate_schema(connection)
        seed_content_catalog(connection)
        seed_debate_rounds(connection)
        connection.commit()


def migrate_debate_schema(connection):
    columns = {
        'debates': {
            'current_round': 'INTEGER NOT NULL DEFAULT 1',
            'final_feedback': 'TEXT',
            'completed_at': 'TEXT',
        },
        'debate_participants': {
            'ready': 'INTEGER NOT NULL DEFAULT 0',
        },
    }
    for table, additions in columns.items():
        existing = {row['name'] for row in connection.execute(f'PRAGMA table_info({table})')}
        for column, definition in additions.items():
            if column not in existing:
                connection.execute(f'ALTER TABLE {table} ADD COLUMN {column} {definition}')


def seed_debate_rounds(connection):
    debates = connection.execute('SELECT id, status FROM debates').fetchall()
    for debate in debates:
        for round_number in range(1, 4):
            if round_number == 1:
                status = 'active' if debate['status'] == 'in_progress' else 'waiting_ready'
            else:
                status = 'not_started'
            connection.execute(
                'INSERT OR IGNORE INTO debate_rounds (debate_id, round_number, status) VALUES (?, ?, ?)',
                (debate['id'], round_number, status),
            )
        if debate['status'] == 'in_progress':
            connection.execute(
                'UPDATE debate_participants SET ready = 1 WHERE debate_id = ?',
                (debate['id'],),
            )


def seed_content_catalog(connection):
    rows = [
        ('Ramayana', 'stories', 'The epic journey of Rama, Sita, Lakshmana, and Hanuman.', '/stories/ramayana'),
        ('Mahabharata', 'stories', 'The great epic of the Kurukshetra war and the Pandavas and Kauravas.', '/stories/mahabharata'),
        ('Bhagavad Gita', 'philosophy', 'A foundational teaching on duty, wisdom, and action.', '/learning/gita'),
        ('Lord Krishna', 'characters', 'A guide, teacher, warrior, and embodiment of wisdom.', '/characters/krishna'),
        ('Lord Rama', 'characters', 'The righteous king, protector, and ideal of dharma.', '/characters/rama'),
        ('Hanuman', 'characters', 'Devotion, courage, and service in action.', '/characters/hanuman'),
        ('Dharma and Karma', 'concepts', 'How actions, duty, and moral choices shape life and learning.', '/concepts/dharma-karma'),
        ('Sanskrit word of the day', 'language', 'A daily Sanskrit term with meaning and context.', '/language/sanskrit'),
        ('Ancient Indian astronomy', 'science', 'Observing, measuring, and understanding the sky in traditional knowledge systems.', '/science/astronomy'),
        ('Ancient Indian mathematics', 'science', 'The brilliance of zero, geometry, and numerical systems.', '/science/mathematics'),
        ('The Four Purusharthas', 'philosophy', 'Dharma, artha, kama, and moksha as life goals.', '/concepts/purusharthas'),
        ('Ganesha', 'characters', 'The remover of obstacles and a symbol of wisdom and beginnings.', '/characters/ganesha'),
    ]
    existing = connection.execute('SELECT title, category FROM content_catalog').fetchall()
    existing_keys = {(row['title'], row['category']) for row in existing}
    for title, category, description, url in rows:
        if (title, category) not in existing_keys:
            connection.execute(
                'INSERT INTO content_catalog (title, category, description, url) VALUES (?, ?, ?, ?)',
                (title, category, description, url),
            )


def safe_age_group(value):
    if value in AGE_GROUPS:
        return value
    return '13-15'


class AIProviderError(RuntimeError):
    def __init__(self, message, status_code=502, category='provider_error'):
        super().__init__(message)
        self.status_code = status_code
        self.category = category


def summarize_history(conversation_id):
    with get_db_connection() as connection:
        rows = connection.execute(
            'SELECT sender, text, created_at, metadata FROM ai_messages WHERE conversation_id = ? ORDER BY id ASC',
            (conversation_id,),
        ).fetchall()
        return [dict(row) for row in rows]


def build_provider_history(rows):
    history = []
    pending_student_message = None
    for row in rows:
        if row['sender'] == 'student':
            pending_student_message = {'sender': 'student', 'text': row['text']}
            continue
        if row['sender'] != 'guru' or not pending_student_message:
            continue
        try:
            metadata = json.loads(row['metadata'] or '{}')
        except (json.JSONDecodeError, TypeError):
            metadata = {}
        if metadata.get('provider') in ('gemini', 'openai'):
            history.extend((pending_student_message, {'sender': 'guru', 'text': row['text']}))
        pending_student_message = None
    return history


def get_gemini_client():
    api_key = os.environ.get('GEMINI_API_KEY') or GEMINI_API_KEY
    if not api_key:
        raise AIProviderError('AI is not configured. Set GEMINI_API_KEY to enable Gemini.', 503)

    cached = app.extensions.get('gemini_client')
    if cached and cached[0] == api_key:
        return cached[1]
    try:
        client = genai.Client(
            api_key=api_key,
            http_options=types.HttpOptions(
                api_version='v1beta',
                timeout=30_000,
                retry_options=types.HttpRetryOptions(attempts=1),
            ),
        )
    except Exception as error:
        log_gemini_failure(error, 'client_initialization')
        raise AIProviderError('Gemini could not initialize. Check the server configuration.') from error
    app.extensions['gemini_client'] = (api_key, client)
    return client


def log_gemini_failure(error, category, provider_status=None):
    detail = str(getattr(error, 'message', error))
    api_key = os.environ.get('GEMINI_API_KEY') or GEMINI_API_KEY
    if api_key:
        detail = detail.replace(api_key, '[redacted]')
    logger.warning(
        'Gemini failure category=%s exception=%s provider_status=%s detail=%s',
        category,
        type(error).__name__,
        provider_status if provider_status is not None else getattr(error, 'code', None),
        detail[:1000],
    )


def gemini_api_error(error, model=None):
    model = model or GEMINI_MODEL
    raw_code = getattr(error, 'code', None)
    try:
        code = int(raw_code)
    except (TypeError, ValueError):
        code = None
    detail = str(getattr(error, 'message', error)).lower()
    if code == 404 or any(term in detail for term in ('model not found', 'not supported for generatecontent')):
        category = 'unsupported_model'
        message = f'Gemini model "{model}" is unavailable for content generation with this API key. Check GEMINI_MODEL.'
    elif code == 401 or any(term in detail for term in ('api key not valid', 'invalid api key', 'api_key_invalid')):
        category = 'invalid_api_key'
        message = 'Gemini rejected GEMINI_API_KEY. Verify the key in the server .env file.'
    elif code == 403:
        category = 'permission_denied'
        message = 'Gemini denied access. Check this keyâ€™s API permissions, project, and model access.'
    elif code == 400 and 'developer instruction is not enabled' in detail:
        category = 'unsupported_api_feature'
        message = 'The Gemini API version does not support system instructions. Use the supported v1beta endpoint.'
    elif code == 429 or any(term in detail for term in ('quota', 'resource_exhausted', 'rate limit')):
        category = 'quota_or_rate_limit'
        message = 'Gemini quota or rate limit reached. Check the Google AI project quota and try again later.'
    elif code == 504 or any(term in detail for term in ('deadline_exceeded', 'deadline expired', 'timed out')):
        category = 'provider_deadline'
        message = 'Gemini did not finish before Googleâ€™s request deadline. Please retry shortly.'
    elif code is not None and code >= 500:
        category = 'google_server_error'
        message = f'Google Gemini returned a server error (HTTP {code}). Please retry shortly.'
    else:
        category = 'provider_request_error'
        message = f'Gemini rejected the request (HTTP {code or "unknown"}). Check model and API configuration.'
    status_code = 429 if category == 'quota_or_rate_limit' else 504 if category == 'provider_deadline' else code if code in range(500, 600) else 502
    return AIProviderError(message, status_code, category)


def generate_gemini_content(contents, system_instruction, max_output_tokens=900, temperature=0.5, response_schema=None):
    model = (os.environ.get('GEMINI_MODEL') or GEMINI_MODEL or 'gemini-3.5-flash-lite').strip()
    config = types.GenerateContentConfig(
        system_instruction=system_instruction,
        temperature=temperature,
        max_output_tokens=max_output_tokens,
        response_mime_type='application/json' if response_schema else None,
        response_schema=response_schema,
    )
    try:
        response = get_gemini_client().models.generate_content(
            model=model,
            contents=contents,
            config=config,
        )
    except AIProviderError:
        raise
    except APIError as error:
        provider_error = gemini_api_error(error, model)
        log_gemini_failure(error, provider_error.category)
        raise provider_error from error
    except Exception as error:
        error_name = type(error).__name__.lower()
        if any(term in error_name for term in ('timeout', 'connect', 'network')):
            provider_error = AIProviderError(
                'Could not reach Gemini before the request timed out. Check network connectivity and retry.',
                504,
                'network_timeout',
            )
        else:
            provider_error = AIProviderError(
                'Gemini returned an unexpected response. Check server logs for the redacted diagnostic.',
                502,
                'unexpected_provider_error',
            )
        log_gemini_failure(error, provider_error.category)
        raise provider_error from error

    prompt_feedback = getattr(response, 'prompt_feedback', None)
    prompt_block_reason = getattr(prompt_feedback, 'block_reason', None)
    prompt_block_name = getattr(prompt_block_reason, 'name', None)
    if isinstance(prompt_block_name, str) and prompt_block_name != 'BLOCKED_REASON_UNSPECIFIED':
        raise AIProviderError('Gemini safety filters blocked this question. Try rephrasing it.', 422, 'prompt_blocked')

    candidates = getattr(response, 'candidates', None) or []
    finish_reasons = [
        getattr(getattr(candidate, 'finish_reason', None), 'name', str(getattr(candidate, 'finish_reason', '')))
        for candidate in candidates
    ]
    if any(reason in {'SAFETY', 'BLOCKLIST', 'PROHIBITED_CONTENT', 'SPII'} for reason in finish_reasons):
        raise AIProviderError('Gemini safety filters blocked the response. Try a different question.', 422, 'response_blocked')

    try:
        content = response.text
    except Exception as error:
        log_gemini_failure(error, 'response_extraction')
        raise AIProviderError('Gemini returned an unreadable response. Please try again.', 502, 'response_extraction') from error

    if not isinstance(content, str) or not content.strip():
        logger.warning('Gemini returned an empty text response model=%s finish_reasons=%s', model, finish_reasons)
        raise AIProviderError('Gemini returned no text for this request. Try rephrasing the question.', 502, 'empty_response')
    return content.strip(), model


def generate_gemini_response(question, age_group, history=None):
    system_prompt = (
        'You are MythoVerse AI Guru, a mythology educator focused on Indian epics, philosophy, gods, traditions, and values. '
        'Support questions about the Ramayana, Mahabharata, Bhagavad Gita, Indian philosophy, dharma, karma, traditions, Sanskrit, and ancient knowledge. '
        'Respond in the language the student used unless they request another language. Explain at the requested age level, never invent scripture quotations or put paraphrases in quotation marks, distinguish regional variations and interpretations, and clearly separate traditional narratives, historical evidence, and modern scientific knowledge.'
    )
    contents = [
        {
            'role': 'model' if row['sender'] == 'guru' else 'user',
            'parts': [{'text': row['text']}],
        }
        for row in (history or [])
    ]
    contents.append({
        'role': 'user',
        'parts': [{
            'text': f"Answer in a {AGE_GROUPS[safe_age_group(age_group)]} style for a student. Keep it educational, respectful, and concise. Question: {question}"
        }],
    })
    answer, model = generate_gemini_content(contents, system_prompt, max_output_tokens=900)
    return {
        'answer': answer,
        'provider': 'gemini',
        'model': model,
        'age_group': safe_age_group(age_group),
    }


def generate_gemini_structured_response(prompt, system_instruction, response_schema, age_group):
    age_guidance = AGE_GROUPS[safe_age_group(age_group)]
    contents = [types.Content(
        role='user',
        parts=[types.Part.from_text(text=f'Use language suitable for a {age_guidance} student.\n{prompt}')],
    )]
    text, _ = generate_gemini_content(
        contents,
        system_instruction,
        max_output_tokens=1800,
        temperature=0,
        response_schema=response_schema,
    )
    try:
        return json.loads(text)
    except json.JSONDecodeError as error:
        logger.warning('Gemini structured response was invalid JSON model=%s', GEMINI_MODEL)
        raise AIProviderError('Gemini returned an invalid judge scorecard. No scores were saved.', 502, 'invalid_structured_response') from error


def generate_debate_opponent_argument(debate, position, round_number, student_argument, history):
    round_focus = {
        1: 'Opening: state the AI position and its strongest reasons.',
        2: 'Rebuttal: answer the student\'s previous-round point and add a counterargument.',
        3: 'Final: present the strongest concise closing argument and summarize the case.',
    }[round_number]
    prompt = (
        f"Debate topic: {debate['topic']}\n"
        f"Your assigned position: {position}\n"
        f"Round {round_number} of 3. {round_focus}\n"
        f"The student's current argument: {student_argument}\n"
        'Respond directly to the student, remain respectful, and do not repeat earlier AI arguments. '
        'Return only the argument text, with no role label or scoring.'
    )
    response = build_guru_response(prompt, debate['age_group'], history)
    return response['answer']


def _evaluate_pending_debate_round(debate_id, round_number, requester_id):
    with get_db_connection() as connection:
        debate = connection.execute('SELECT * FROM debates WHERE id = ?', (debate_id,)).fetchone()
        if not debate:
            return jsonify({'error': 'Debate not found.'}), 404
        requester = connection.execute(
            "SELECT id FROM debate_participants WHERE debate_id = ? AND student_id = ? AND role = 'student'",
            (debate_id, requester_id),
        ).fetchone()
        if not requester:
            return jsonify({'error': 'Only a debate participant can request evaluation.'}), 403
        if debate['status'] == 'completed' or round_number != debate['current_round']:
            return jsonify({'error': 'Only the current, incomplete round can be evaluated.'}), 409
        round_row = connection.execute(
            'SELECT status FROM debate_rounds WHERE debate_id = ? AND round_number = ?',
            (debate_id, round_number),
        ).fetchone()
        if not round_row or round_row['status'] != 'awaiting_judge':
            return jsonify({'error': 'Both participants must submit before the Judge can evaluate this round.'}), 409
        participants = connection.execute(
            "SELECT * FROM debate_participants WHERE debate_id = ? AND role IN ('student','ai') ORDER BY CASE role WHEN 'student' THEN 0 ELSE 1 END, id",
            (debate_id,),
        ).fetchall()
        submissions = connection.execute(
            """
            SELECT s.participant_id, s.argument, p.student_id, p.position, p.role
            FROM debate_round_submissions AS s JOIN debate_participants AS p ON p.id = s.participant_id
            WHERE s.debate_id = ? AND s.round_number = ?
            ORDER BY CASE p.role WHEN 'student' THEN 0 ELSE 1 END, p.id
            """,
            (debate_id, round_number),
        ).fetchall()
        if len(participants) != 2 or len(submissions) != 2:
            return jsonify({'error': 'Exactly two participant submissions are required for evaluation.'}), 409
        cursor = connection.execute(
            "UPDATE debate_rounds SET status = 'judging' WHERE debate_id = ? AND round_number = ? AND status = 'awaiting_judge'",
            (debate_id, round_number),
        )
        if cursor.rowcount != 1:
            return jsonify({'error': 'This round is already being evaluated.'}), 409
        previous = connection.execute(
            """
            SELECT s.round_number, p.student_id, p.role, s.argument
            FROM debate_round_submissions AS s JOIN debate_participants AS p ON p.id = s.participant_id
            WHERE s.debate_id = ? AND s.round_number < ? ORDER BY s.round_number, p.id
            """,
            (debate_id, round_number),
        ).fetchall()
        prior_arguments = [
            {'round': row['round_number'], 'speaker': 'Gemini AI Opponent' if row['role'] == 'ai' else row['student_id'], 'argument': row['argument']}
            for row in previous
        ]
        judge_arguments = [
            {'participant_key': key, 'position': row['position'], 'argument': row['argument']}
            for key, row in zip(('A', 'B'), submissions)
        ]

    try:
        judgement = judge_debate_round(debate['topic'], round_number, judge_arguments, prior_arguments, debate['age_group'])
    except AIProviderError as error:
        with get_db_connection() as connection:
            connection.execute(
                "UPDATE debate_rounds SET status = 'awaiting_judge' WHERE debate_id = ? AND round_number = ? AND status = 'judging'",
                (debate_id, round_number),
            )
        return jsonify({
            'error': str(error),
            'category': error.category,
            'round_number': round_number,
            'round_status': 'awaiting_judge',
            'submissions_saved': True,
            'retry_endpoint': f'/api/debate/{debate_id}/rounds/{round_number}/evaluate',
        }), error.status_code

    with get_db_connection() as connection:
        current_debate = connection.execute('SELECT * FROM debates WHERE id = ?', (debate_id,)).fetchone()
        current_round = connection.execute(
            'SELECT status FROM debate_rounds WHERE debate_id = ? AND round_number = ?',
            (debate_id, round_number),
        ).fetchone()
        if not current_round or current_round['status'] != 'judging':
            return jsonify({'error': 'Round state changed while evaluation was running.'}), 409
        result = _persist_judged_round(connection, current_debate, round_number, participants, judgement)
    return jsonify(result), 200


def _validate_feedback_list(value, field_name):
    if not isinstance(value, list) or len(value) > 5:
        raise AIProviderError(f'Gemini Judge returned invalid {field_name}. No scores were saved.', 502, 'invalid_judge_scorecard')
    if any(not isinstance(item, str) or not item.strip() or len(item) > 240 for item in value):
        raise AIProviderError(f'Gemini Judge returned invalid {field_name}. No scores were saved.', 502, 'invalid_judge_scorecard')
    return [item.strip() for item in value]


def _persist_judged_round(connection, debate, round_number, participants, judgement):
    for participant_key, participant in zip(('A', 'B'), participants):
        score = judgement[participant_key]
        connection.execute(
            """
            INSERT INTO debate_round_scores (
                debate_id, round_number, participant_id, relevance, reasoning, evidence,
                clarity, rebuttal, respect, total, explanation, strengths, improvements
            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            """,
            (
                debate['id'], round_number, participant['id'], score['relevance'], score['reasoning'],
                score['evidence'], score['clarity'], score['rebuttal'], score['respect'], score['total'],
                score['explanation'], json.dumps(score['strengths']), json.dumps(score['improvements']),
            ),
        )
    connection.execute(
        "UPDATE debate_rounds SET status = 'completed', judge_summary = ?, completed_at = CURRENT_TIMESTAMP WHERE debate_id = ? AND round_number = ?",
        (judgement['summary'], debate['id'], round_number),
    )
    result = {
        'round_number': round_number,
        'round_status': 'completed',
        'judge_summary': judgement['summary'],
        'scores': [
            {'participant_id': participant['student_id'], 'role': participant['role'], **judgement[key]}
            for key, participant in zip(('A', 'B'), participants)
        ],
    }
    if round_number < 3:
        next_round = round_number + 1
        connection.execute(
            "UPDATE debate_rounds SET status = 'active', started_at = CURRENT_TIMESTAMP WHERE debate_id = ? AND round_number = ?",
            (debate['id'], next_round),
        )
        connection.execute("UPDATE debates SET current_round = ?, status = 'in_progress' WHERE id = ?", (next_round, debate['id']))
        result.update({'status': 'in_progress', 'current_round': next_round})
        return result

    totals = connection.execute(
        'SELECT participant_id, ROUND(SUM(total), 1) AS total_score FROM debate_round_scores WHERE debate_id = ? GROUP BY participant_id',
        (debate['id'],),
    ).fetchall()
    total_by_participant = {row['participant_id']: row['total_score'] for row in totals}
    first_total = total_by_participant.get(participants[0]['id'], 0)
    second_total = total_by_participant.get(participants[1]['id'], 0)
    reward = None
    if round(first_total, 1) == round(second_total, 1):
        winner = 'draw'
    else:
        winning_participant = participants[0] if first_total > second_total else participants[1]
        winner = winning_participant['student_id']
        if winning_participant['role'] == 'student':
            connection.execute(
                "INSERT OR IGNORE INTO dharma_reward_outbox (debate_id, student_id, points, status) VALUES (?, ?, 5, 'pending_integration')",
                (debate['id'], winning_participant['student_id']),
            )
            reward_row = connection.execute(
                'SELECT points, status, created_at FROM dharma_reward_outbox WHERE debate_id = ?',
                (debate['id'],),
            ).fetchone()
            reward = dict(reward_row) if reward_row else None
    summaries = connection.execute(
        'SELECT judge_summary FROM debate_rounds WHERE debate_id = ? ORDER BY round_number',
        (debate['id'],),
    ).fetchall()
    final_feedback = '\n\n'.join(row['judge_summary'] for row in summaries if row['judge_summary'])
    connection.execute(
        "UPDATE debates SET status = 'completed', current_round = 3, winner = ?, final_feedback = ?, completed_at = CURRENT_TIMESTAMP WHERE id = ?",
        (winner, final_feedback, debate['id']),
    )
    scorecard_rows = connection.execute(
        """
        SELECT s.round_number, p.student_id AS participant_id, p.role, p.position,
               s.relevance, s.reasoning, s.evidence, s.clarity, s.rebuttal, s.respect,
               s.total, s.explanation, s.strengths, s.improvements
        FROM debate_round_scores AS s JOIN debate_participants AS p ON p.id = s.participant_id
        WHERE s.debate_id = ? ORDER BY s.round_number, p.id
        """,
        (debate['id'],),
    ).fetchall()
    scorecard = []
    for row in scorecard_rows:
        item = dict(row)
        item['strengths'] = json.loads(item['strengths'])
        item['improvements'] = json.loads(item['improvements'])
        scorecard.append(item)
    result.update({
        'status': 'completed',
        'winner': winner,
        'total_scores': [
            {'participant_id': participant['student_id'], 'role': participant['role'],
             'score': total_by_participant.get(participant['id'], 0)}
            for participant in participants
        ],
        'scorecard': scorecard,
        'final_feedback': final_feedback,
        'reward': reward,
        'integration_notice': 'Dharma Points service is not connected; the 5-point reward is queued in the integration outbox.' if reward else None,
    })
    return result


def judge_debate_round(topic, round_number, participant_arguments, prior_arguments, age_group):
    if len(participant_arguments) != 2:
        raise AIProviderError('A Judge requires exactly two submitted arguments.', 409, 'round_not_ready')
    system_instruction = (
        'You are the independent MythoVerse AI Debate Judge. You are not a debater. Evaluate exactly two submitted arguments using the same six criteria: '
        'relevance to topic, logical reasoning, evidence/examples, clarity, rebuttal strength, and respectful communication. '
        'For Round 1, score rebuttal as anticipation of likely counterarguments. Give each criterion an integer score from 0 to 10. '
        'Use the provided participant keys A and B exactly once. Explain evidence-based feedback, do not invent facts or citations, and return only the required JSON.'
    )
    prompt_data = {
        'topic': topic,
        'round': round_number,
        'round_focus': {
            1: 'opening arguments',
            2: 'rebuttals to the previous round',
            3: 'final arguments',
        }[round_number],
        'previous_round_arguments': prior_arguments,
        'current_arguments': [
            {'participant_key': 'A', 'position': participant_arguments[0]['position'], 'argument': participant_arguments[0]['argument']},
            {'participant_key': 'B', 'position': participant_arguments[1]['position'], 'argument': participant_arguments[1]['argument']},
        ],
    }
    generated = generate_gemini_structured_response(
        json.dumps(prompt_data, ensure_ascii=False),
        system_instruction,
        JUDGE_RESPONSE_SCHEMA,
        age_group,
    )
    if not isinstance(generated, dict) or not isinstance(generated.get('scorecards'), list):
        raise AIProviderError('Gemini Judge returned a malformed scorecard. No scores were saved.', 502, 'invalid_judge_scorecard')
    cards = generated['scorecards']
    if len(cards) != 2 or {card.get('participant_key') for card in cards if isinstance(card, dict)} != {'A', 'B'}:
        raise AIProviderError('Gemini Judge did not score both participants exactly once. No scores were saved.', 502, 'invalid_judge_scorecard')

    validated = {}
    for card in cards:
        scores = {}
        for criterion in JUDGE_CRITERIA:
            value = card.get(criterion)
            if type(value) not in (int, float) or not math.isfinite(value) or not 0 <= value <= 10:
                raise AIProviderError(f'Gemini Judge returned an invalid {criterion} score. No scores were saved.', 502, 'invalid_judge_scorecard')
            scores[criterion] = round(float(value), 1)
        explanation = card.get('explanation')
        if not isinstance(explanation, str) or not explanation.strip() or len(explanation) > 1200:
            raise AIProviderError('Gemini Judge returned invalid score feedback. No scores were saved.', 502, 'invalid_judge_scorecard')
        validated[card['participant_key']] = {
            **scores,
            'total': round(sum(scores.values()) / len(JUDGE_CRITERIA), 1),
            'explanation': explanation.strip(),
            'strengths': _validate_feedback_list(card.get('strengths'), 'strengths'),
            'improvements': _validate_feedback_list(card.get('improvements'), 'improvements'),
        }
    summary = generated.get('summary')
    if not isinstance(summary, str) or not summary.strip() or len(summary) > 2000:
        raise AIProviderError('Gemini Judge returned invalid round feedback. No scores were saved.', 502, 'invalid_judge_scorecard')
    return {'A': validated['A'], 'B': validated['B'], 'summary': summary.strip()}


def build_guru_response(question, age_group, history=None):
    return generate_gemini_response(question, age_group, history)


