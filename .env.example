# Optional Flask settings. The local dataset workflow needs no API credentials.
SECRET_KEY=change-this-development-secret
# DATABASE_PATH=C:/path/to/mythoverse.db

# Optional real LLM Debate Room provider. Leave unset to use Dataset Practice
# mode only. The endpoint must accept an OpenAI-compatible /chat/completions
# JSON request; the API key is read only by the server.
# DEBATE_PROVIDER=llm
# DEBATE_LLM_ENDPOINT=https://your-provider.example/v1/chat/completions
# DEBATE_LLM_MODEL=your-model-name
# DEBATE_LLM_API_KEY=replace-with-server-side-key
